#version 450
#extension GL_EXT_shader_16bit_storage: require
// Fuse pixel shuffle, resize, flow scaling and accumulated refinement.
layout(binding=0) readonly buffer Coarse { float16_t coarse[]; };
layout(binding=1) readonly buffer Previous { float previous[]; };
layout(binding=2) writeonly buffer Result { float result[]; };
layout(push_constant) uniform parameter { int w; int h; int scale; int stage; int nhwc; } p;
float pixel(int c,ivec2 q) {
 int w=p.w/p.scale/2,h=p.h/p.scale/2;
 int channel=c*4+(q.y%2)*2+q.x%2;
 return coarse[p.nhwc!=0?((q.y/2)*w+q.x/2)*24+channel:channel*w*h+(q.y/2)*w+q.x/2];
}
vec4 pixels(ivec2 q){return vec4(pixel(0,q),pixel(1,q),pixel(2,q),pixel(3,q));}
void main(){
 ivec2 q=ivec2(gl_GlobalInvocationID.xy);if(q.x>=p.w||q.y>=p.h)return;
 ivec2 size=ivec2(p.w,p.h)/p.scale;
 vec2 pos=clamp((vec2(q)+.5)/float(p.scale)-.5,vec2(0),vec2(size-1));
 ivec2 lo=ivec2(floor(pos)),hi=min(lo+1,size-1);vec2 f=fract(pos);
 vec4 v=mix(mix(pixels(lo),pixels(ivec2(hi.x,lo.y)),f.x),mix(pixels(ivec2(lo.x,hi.y)),pixels(hi),f.x),f.y)*float(p.scale);
 float m=mix(mix(pixel(4,lo),pixel(4,ivec2(hi.x,lo.y)),f.x),mix(pixel(4,ivec2(lo.x,hi.y)),pixel(4,hi),f.x),f.y);
 int i=q.y*p.w+q.x,n=p.w*p.h;
 if(p.stage!=0)v+=vec4(previous[i],previous[n+i],previous[2*n+i],previous[3*n+i]);
 result[i]=v.x;result[n+i]=v.y;result[2*n+i]=v.z;result[3*n+i]=v.w;result[4*n+i]=m;
}
