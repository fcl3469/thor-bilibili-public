#version 450
// A bounded SDR proxy is used only for motion estimation. Presentation retains
// the original PQ values in separate FP16 textures throughout interpolation.
layout(binding=0) uniform sampler2D frame;
layout(binding=1,rgba8) uniform writeonly image2D proxy;
layout(push_constant) uniform parameter {int width;int height;} p;
vec3 linearNits(vec3 pq){vec3 v=pow(clamp(pq,0.0,1.0),vec3(1.0/78.84375));return 10000.0*pow(max(v-0.8359375,0.0)/max(18.8515625-18.6875*v,vec3(1e-6)),vec3(1.0/0.1593017578125));}
void main(){ivec2 q=ivec2(gl_GlobalInvocationID.xy);if(q.x>=p.width||q.y>=p.height)return;
 vec3 wide=linearNits(texelFetch(frame,q,0).rgb)/203.0;
 vec3 rgb=vec3(1.6605*wide.r-.5876*wide.g-.0728*wide.b,-.1246*wide.r+1.1329*wide.g-.0083*wide.b,-.0182*wide.r-.1006*wide.g+1.1187*wide.b);
 rgb=max(rgb,vec3(0));float luma=dot(rgb,vec3(.2126,.7152,.0722));rgb=pow(clamp(rgb/(1.0+luma),0.0,1.0),vec3(1.0/2.2));imageStore(proxy,q,vec4(rgb,1));
}
