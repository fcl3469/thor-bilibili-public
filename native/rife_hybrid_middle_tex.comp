#version 450
// Stage 2: sample the resident frame textures with hardware bilinear filtering.
// Flow reconstruction still writes every full-resolution pixel for stage 3.
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require
layout(binding=0) uniform sampler2D A;
layout(binding=1) uniform sampler2D B;
layout(binding=2) uniform sampler2D EA;
layout(binding=3) uniform sampler2D EB;
layout(binding=4) writeonly buffer Flow { float flow[]; };
layout(binding=5) writeonly buffer X { f16vec4 result[]; };
layout(binding=6) readonly buffer Coarse { float16_t coarse[]; };
layout(binding=7) readonly buffer Previous { float16_t previous[]; };
layout(push_constant) uniform parameter { int w; int h; int scale; int stage; int nhwc; } p;

float flowPixel(int c,ivec2 q) {
 int w=p.w/4/2,h=p.h/4/2;
 int channel=c*4+(q.y%2)*2+q.x%2;
 return float(coarse[p.nhwc!=0?((q.y/2)*w+q.x/2)*24+channel:channel*w*h+(q.y/2)*w+q.x/2]);
}
vec4 pixels(ivec2 q){return vec4(flowPixel(0,q),flowPixel(1,q),flowPixel(2,q),flowPixel(3,q));}
float coarse0(int c,ivec2 q){int channel=c*4+(q.y%2)*2+q.x%2;return float(previous[((q.y/2)*(p.w/16)+q.x/2)*24+channel]);}
vec4 vector0(ivec2 q){return vec4(coarse0(0,q),coarse0(1,q),coarse0(2,q),coarse0(3,q));}
void previousFlow(ivec2 q,out vec4 f,out float m){
 ivec2 size=ivec2(p.w,p.h)/8;vec2 pos=clamp((vec2(q)+.5)/8.0-.5,vec2(0),vec2(size-1));ivec2 lo=ivec2(floor(pos)),hi=min(lo+1,size-1);vec2 t=fract(pos);
 f=mix(mix(vector0(lo),vector0(ivec2(hi.x,lo.y)),t.x),mix(vector0(ivec2(lo.x,hi.y)),vector0(hi),t.x),t.y)*8.0;
 m=mix(mix(coarse0(4,lo),coarse0(4,ivec2(hi.x,lo.y)),t.x),mix(coarse0(4,ivec2(lo.x,hi.y)),coarse0(4,hi),t.x),t.y);
}
void reconstruct(ivec2 q,out vec4 v,out float m){
 ivec2 size=ivec2(p.w,p.h)/4;
 vec2 pos=clamp((vec2(q)+.5)/float(4)-.5,vec2(0),vec2(size-1));
 ivec2 lo=ivec2(floor(pos)),hi=min(lo+1,size-1);vec2 f=fract(pos);
 v=mix(mix(pixels(lo),pixels(ivec2(hi.x,lo.y)),f.x),mix(pixels(ivec2(lo.x,hi.y)),pixels(hi),f.x),f.y)*float(4);
 m=mix(mix(flowPixel(4,lo),flowPixel(4,ivec2(hi.x,lo.y)),f.x),mix(flowPixel(4,ivec2(lo.x,hi.y)),flowPixel(4,hi),f.x),f.y);
 int i=q.y*p.w+q.x,n=p.w*p.h;
 vec4 pf;float pm;previousFlow(q,pf,pm);v+=pf;
 flow[i]=v.x;flow[n+i]=v.y;flow[2*n+i]=v.z;flow[3*n+i]=v.w;flow[4*n+i]=m;
}
vec3 framePixel(int image,vec2 pos){
 vec2 uv=(clamp(pos,vec2(0),vec2(p.w-1,p.h-1))+.5)/vec2(p.w,p.h);
 return image==0?textureLod(A,uv,0).rgb:textureLod(B,uv,0).rgb;
}
vec4 feature(int image,vec2 pos){
 vec2 uv=(clamp(pos,vec2(0),vec2(p.w-1,p.h-1))+.5)/vec2(p.w,p.h);
 return image==2?textureLod(EA,uv,0):textureLod(EB,uv,0);
}
struct Values{vec4 a;vec4 b;vec4 ea;vec4 eb;vec4 f;float mask;};
Values values(ivec2 q){
 Values v;
 if(p.stage==0){v.a=vec4(framePixel(0,vec2(q)),0);v.b=vec4(framePixel(1,vec2(q)),0);v.ea=feature(2,vec2(q));v.eb=feature(3,vec2(q));v.f=vec4(0);v.mask=0;return v;}
 reconstruct(q,v.f,v.mask);
 vec2 pos0=vec2(q)+v.f.xy,pos1=vec2(q)+v.f.zw;
 v.a=vec4(framePixel(0,pos0),0);v.b=vec4(framePixel(1,pos1),0);
 v.ea=feature(2,pos0);v.eb=feature(3,pos1);
 return v;
}
void store4(int pixelIndex,int group,f16vec4 v){result[pixelIndex*5+group]=v;}
void main(){
 ivec2 q=ivec2(gl_GlobalInvocationID.xy);int w=p.w/p.scale,h=p.h/p.scale;if(q.x>=w||q.y>=h)return;
 vec2 src=clamp((vec2(q)+.5)*float(p.scale)-.5,vec2(0),vec2(p.w-1,p.h-1));
 ivec2 lo=ivec2(floor(src)),hi=min(lo+1,ivec2(p.w-1,p.h-1));vec2 f=fract(src);
 Values r=values(lo);
 if(p.scale!=1){
  Values s=values(ivec2(hi.x,lo.y)),t=values(ivec2(lo.x,hi.y)),u=values(hi);
  r.a=mix(mix(r.a,s.a,f.x),mix(t.a,u.a,f.x),f.y);
  r.b=mix(mix(r.b,s.b,f.x),mix(t.b,u.b,f.x),f.y);
  r.ea=mix(mix(r.ea,s.ea,f.x),mix(t.ea,u.ea,f.x),f.y);
  r.eb=mix(mix(r.eb,s.eb,f.x),mix(t.eb,u.eb,f.x),f.y);
  r.f=mix(mix(r.f,s.f,f.x),mix(t.f,u.f,f.x),f.y);
  r.mask=mix(mix(r.mask,s.mask,f.x),mix(t.mask,u.mask,f.x),f.y);
 }
 int i=q.y*w+q.x;
 store4(i,0,f16vec4(r.a.r,r.a.g,r.a.b,r.b.r));
 store4(i,1,f16vec4(r.b.g,r.b.b,r.ea.r,r.ea.g));
 store4(i,2,f16vec4(r.ea.b,r.ea.a,r.eb.r,r.eb.g));
 store4(i,3,f16vec4(r.eb.b,r.eb.a,.5,r.mask));
 store4(i,4,f16vec4(r.f.r/float(p.scale),r.f.g/float(p.scale),r.f.b/float(p.scale),r.f.a/float(p.scale)));
}
