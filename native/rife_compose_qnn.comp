#version 450
#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
layout(binding=0) readonly buffer Previous { uint previous[]; };
layout(binding=1) readonly buffer Current { uint current[]; };
layout(binding=2) readonly buffer Flow { sfp flow[]; };
layout(binding=3) readonly buffer Mask { sfp mask[]; };
layout(binding=4) writeonly buffer Middle { uint middle[]; };
layout(push_constant) uniform parameter {
 int width; int height; int stride; int plane;
 int workWidth; int workHeight; int workStride; int flowPlane; int left; int top;
} p;
vec4 flowAt(ivec2 q){int i=q.y*p.workStride+q.x;return vec4(buffer_ld1(flow,i),buffer_ld1(flow,p.flowPlane+i),buffer_ld1(flow,2*p.flowPlane+i),buffer_ld1(flow,3*p.flowPlane+i));}
float maskAt(ivec2 q){float logit=float(buffer_ld1(mask,4*p.flowPlane+q.y*p.workStride+q.x));return 1.0/(1.0+exp(-clamp(logit,-20.0,20.0)));}
vec3 pixel(ivec2 q,bool next){int i=(q.y+p.top)*p.stride+q.x+p.left;return unpackUnorm4x8(next?current[i]:previous[i]).rgb;}
vec3 sampleFrame(vec2 q,bool next){
 q=clamp(q,vec2(0),vec2(p.width-1,p.height-1));ivec2 a=ivec2(floor(q)),b=min(a+1,ivec2(p.width-1,p.height-1));vec2 f=fract(q);
 return mix(mix(pixel(a,next),pixel(ivec2(b.x,a.y),next),f.x),mix(pixel(ivec2(a.x,b.y),next),pixel(b,next),f.x),f.y);
}
void main(){
 ivec3 q=ivec3(gl_GlobalInvocationID);if(q.x>=p.width||q.y>=p.height||q.z!=0)return;
 vec2 scale=vec2(p.width,p.height)/vec2(p.workWidth,p.workHeight);
 vec2 at=clamp((vec2(q.xy)+0.5)/scale-0.5,vec2(0),vec2(p.workWidth-1,p.workHeight-1));
 ivec2 a=ivec2(floor(at)),b=min(a+1,ivec2(p.workWidth-1,p.workHeight-1));vec2 f=fract(at);
 vec4 displacement=mix(mix(flowAt(a),flowAt(ivec2(b.x,a.y)),f.x),mix(flowAt(ivec2(a.x,b.y)),flowAt(b),f.x),f.y);
 float weight=mix(mix(maskAt(a),maskAt(ivec2(b.x,a.y)),f.x),mix(maskAt(ivec2(a.x,b.y)),maskAt(b),f.x),f.y);
 if(any(isnan(displacement))||any(isinf(displacement))||isnan(weight)||isinf(weight)){displacement=vec4(0);weight=0.5;}
 vec3 before=sampleFrame(vec2(q.xy)+displacement.xy*scale,false),after=sampleFrame(vec2(q.xy)+displacement.zw*scale,true);
 middle[q.y*p.width+q.x]=packUnorm4x8(vec4(clamp(mix(after,before,clamp(weight,0.0,1.0)),0.0,1.0),1.0));
}
